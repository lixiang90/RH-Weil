      "original_text": "\"\"\"Actual AM-energy interval at the five exact old-relaxation primal points.\n\nThese are diagnostic physical gap configurations, not zeta zero data.\nAn upper here bounds only the value at this particular configuration.\n\"\"\"\nfrom pathlib import Path\nfrom fractions import Fraction as Q\nimport hashlib,json,time\nimport independent_outer_audit as audit\n\nstarted=time.perf_counter()\nformula=audit.ROOT/'tmp/research-resume-20261011/audit/independent_fraction_audit.py'\nassert audit.sha(formula)=='f3804b0a44a09d46a5116cbbe0ec9d08837fa746940d50eb40b73bd054949c05'\nnamespace={}\nexec(formula.read_text(encoding='utf-8').split('periods=',1)[0],namespace)\nK,square,add,scale=map(namespace.get,('kernel','sq','add','sc'))\ndef outward(interval):\n    unit=10**24\n    lo,hi=(x*unit for x in interval)\n    return Q(lo.numerator//lo.denominator,unit),Q(-((-hi.numerator)//hi.denominator),unit)\nreport=[]\nfor record in audit.load(audit.WORK/'primal-model-audit.json')['records']:\n    gaps=list(map(Q,record['exact_feasible_primal'][:7]))\n    pressure=sum((Q(b,audit.SA)*g for b,g in zip(audit.fees,gaps)),Q(0))\n    value=(pressure,pressure)\n    for i,j,weight in audit.terms:\n        span=sum(gaps[i:j],Q(0))\n        value=add(value,scale(square(outward(K(span))),Q(weight,audit.SA)))\n    value=outward(value)\n    outcome={'label':record['label'],'branch':record['branch'],\n       'scope':'one exact physical gap configuration; not actual-zeta upper or a complete-box energy minimum',\n       'gap_configuration':list(map(str,gaps)),'actual_F8_energy_lower':str(value[0]),\n       'actual_F8_energy_upper':str(value[1]),'lower_minus_target':str(value[0]-audit.FLOOR),\n       'upper_minus_target':str(value[1]-audit.FLOOR)}\n    report.append(outcome)\n    print(record['label'],record['branch'],'actual_F8',float(value[0]),float(value[1]),\n          'lower_margin',float(value[0]-audit.FLOOR),flush=True)\nout={'scope':'independent rational interval evaluation of actual AM kernel at five exact diagnostic configurations',\n    'formula_source_sha256':audit.sha(formula),'script_sha256':audit.sha(Path(__file__)),\n    'primal_report_sha256':audit.sha(audit.WORK/'primal-model-audit.json'),\n    'records':report,'elapsed_seconds':time.perf_counter()-started}\n(audit.WORK/'primal-actual-energy.json').write_text(json.dumps(out,indent=2)+'\\n',encoding='utf-8',newline='\\n')\n"
