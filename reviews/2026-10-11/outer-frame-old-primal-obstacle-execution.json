    "primal_model_audit.py": {
      "original_local_path": "E:\\codex-build\\RH-Weil\\tmp\\research-round506-20261011\\audit\\primal_model_audit.py",
      "raw_sha256": "69cce2101910a61b9928290a7768a8e9205568ec4eb06801a241b7227dd7cdbc",
      "canonical_lf_sha256": "69cce2101910a61b9928290a7768a8e9205568ec4eb06801a241b7227dd7cdbc",
      "original_text": "\"\"\"Exact primal diagnostics for five already-stored finite outer relaxations.\n\nThis imports only the independent audit module, never an author optimizer.\nFloating LP locates a vertex; all acceptance uses an independently solved\nFraction vertex and checks every inequality, box and objective exactly.\n\"\"\"\nfrom fractions import Fraction as Q\nfrom pathlib import Path\nimport json, math, time\nfrom scipy.optimize import linprog\nimport independent_outer_audit as audit\n\ndef exact_vertex(A, b, box, floating):\n    n=len(floating); candidates=[]\n    for i,(row,rhs) in enumerate(zip(A,b)):\n        slack=float(rhs)-sum(float(v)*x for v,x in zip(row,floating))\n        if abs(slack)<2e-8: candidates.append((row,rhs,('row',i),abs(slack)))\n    for i,(lo,hi) in enumerate(box):\n        for side,edge in [('lo',lo),('hi',hi)]:\n            if abs(floating[i]-float(edge))<2e-8:\n                row=[Q(0)]*n;row[i]=Q(1)\n                candidates.append((row,edge,('box',i,side),abs(floating[i]-float(edge))))\n    candidates.sort(key=lambda v:v[3]); pivots={}; selected=[]\n    for row,rhs,tag,_ in candidates:\n        row=row[:];rhs=Q(rhs)\n        for pivot,(old,oldrhs) in sorted(pivots.items()):\n            if row[pivot]:\n                mul=row[pivot];row=[a-mul*c for a,c in zip(row,old)];rhs-=mul*oldrhs\n        nz=next((i for i,v in enumerate(row) if v),None)\n        if nz is None: continue\n        mul=row[nz];row=[v/mul for v in row];rhs/=mul\n        pivots[nz]=row,rhs;selected.append(tag)\n        if len(pivots)==n:break\n    assert len(pivots)==n,('vertex rank',len(pivots),n)\n    answer=[Q(0)]*n\n    for pivot in sorted(pivots,reverse=True):\n        row,rhs=pivots[pivot]\n        answer[pivot]=rhs-sum(row[j]*answer[j] for j in range(pivot+1,n))\n    assert all(sum(v*x for v,x in zip(row,answer))<=rhs for row,rhs in zip(A,b))\n    assert all(lo<=x<=hi for x,(lo,hi) in zip(answer,box))\n    return answer, selected\n\ndef additional_reanchored(cell,branch,x):\n    d=audit.closure(cell,branch)\n    losses=[];number=0\n    for col,(i,j,_) in enumerate(audit.terms,7):\n        lo,hi=Q(-d[j][i],5*audit.SC),Q(d[i][j],5*audit.SC)\n        t=sum(x[i:j],Q(0))\n        for p,(pack,n) in audit.points.items():\n            k=(p+16384)>>15\n            if k>=16:continue\n            xp=Q(p,audit.SC)\n            ra=Q((audit.region[0]>>(20*k))&1048575,audit.SC)\n            rb=Q((audit.region[1]>>(20*k))&1048575,audit.SC)\n            if not ra<=min(lo,xp)<=max(hi,xp)<=rb:continue\n            for side in ('L','U'):\n                slope,constant=audit.tangent(p,pack,lo,hi,side)\n                excess=slope*t+constant-x[col];number+=1\n                if excess>0:losses.append((excess,i,j,p,n,side))\n    return number,sorted(losses,reverse=True)\n\ndef repair_feasible(cell, branch, A, b, box, floating):\n    # Project rounded prefix potentials onto the exact integer difference system.\n    # d is the complete closure, so min_i(p_i+d_ij) satisfies every d-bound.\n    # This does not infer exact feasibility from a floating solver status.\n    d=audit.closure(cell,branch);scale=10**10;unit=5*audit.SC*scale\n    potentials=[Q(0)]\n    for gap in floating[:7]: potentials.append(potentials[-1]+Q(float(gap)))\n    raw=[(p*unit).numerator//(p*unit).denominator for p in potentials]\n    projected=[min(raw[i]+d[i][j]*scale for i in range(8)) for j in range(8)]\n    x=[Q(projected[i+1]-projected[i],unit) for i in range(7)]+[Q(0)]*26\n    # All square rows have coefficient -1 in exactly one auxiliary coordinate.\n    for row,rhs in zip(A,b):\n        square=[j for j in range(7,33) if row[j]]\n        if not square:continue\n        assert len(square)==1 and row[square[0]]==-1\n        x[square[0]]=max(x[square[0]],sum(row[j]*x[j] for j in range(7))-rhs)\n    assert all(sum(v*y for v,y in zip(row,x))<=rhs for row,rhs in zip(A,b))\n    assert all(lo<=y<=hi for y,(lo,hi) in zip(x,box))\n    return x\n\ndef main():\n    started=time.perf_counter();records=[]\n    patches={r['label']:r for r in audit.pub['frame_patches']}\n    split=audit.pub['frame_split_patches'][0]\n    for label,branchindex in [(69,None),(74,None),(131,None),(183,None),(17,1)]:\n        cell=audit.old['captured_cells'][label]\n        if branchindex is None:\n            rec=patches[label];branch=None\n            prob=audit.matrix(cell,rec['added_rows'])\n        else:\n            rec=split['branches'][branchindex];branch=(split['span'],rec['bounds_5sc'])\n            prob=audit.matrix(cell,rec['added_rows'],branch)\n        obj,A,b,box,_=prob\n        result=linprog([float(v/audit.SA) for v in obj],A_ub=[[float(v) for v in row] for row in A],\n            b_ub=list(map(float,b)),bounds=[tuple(map(float,z)) for z in box],method='highs',\n            options={'primal_feasibility_tolerance':1e-10,'dual_feasibility_tolerance':1e-10})\n        assert result.success,result.message\n        x=repair_feasible(cell,branch,A,b,box,result.x)\n        objective=sum(v*t for v,t in zip(obj,x))/audit.SA\n        assert objective<audit.FLOOR\n        count,violations=additional_reanchored(cell,branch,x)\n        record={'label':label,'branch':branchindex,'scope':'specified old linear relaxation only; not actual AM-energy or zeta upper',\n          'exact_feasible_primal':list(map(str,x)),'objective_exact':str(objective),\n          'target_deficit':str(audit.FLOOR-objective),'all_rows_exactly_verified':len(A),'all_boxes_exactly_verified':len(box),\n          'primal_method':'exact integer prefix projection plus maximum of all specified affine square lower rows',\n          'additional_valid_anchor_rows_considered':count,\n          'additional_rows_violated':len(violations),'largest_valid_new_row_violations':\n              [{'excess':str(v),'span':[i,j],'point':p,'catalog':n,'side':s} for v,i,j,p,n,s in violations[:5]]}\n        records.append(record)\n        print('EXACT',label,branchindex,'objective',float(objective),'below_target',str(audit.FLOOR-objective),\n              'new_rows_rule_out_vertex',len(violations),flush=True)\n    out={'scope':'finite-model obstruction to upgrading unchanged old rows; valid anchor reanchoring may remove it',\n      'not_actual_zeta_upper':True,'not_actual_AM_energy_upper':True,'ran_author_optimizer':False,\n      'program_sha256':audit.sha(Path(__file__)),'independent_matrix_program_sha256':audit.sha(Path(audit.__file__)),\n      'floor':str(audit.FLOOR),'records':records,'elapsed_seconds':time.perf_counter()-started}\n    (audit.WORK/'primal-model-audit.json').write_text(json.dumps(out,indent=2)+'\\n',encoding='utf-8',newline='\\n')\n    print('PASS',out['elapsed_seconds'])\n\nif __name__=='__main__':main()\n"
    },
